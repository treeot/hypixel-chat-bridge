# Generated by `npm run docs:gen` from src/core/envCatalog.ts. Full reference: docs/configuration.md
# Empty values mean "unset" (the default is used).

# ── Required ──────────────────────────────────────────────────────────────
DISCORD_TOKEN=                      # Discord bot token (Developer Portal → your application → Bot → Reset Token).
OWNER_ID=                           # Your Discord user ID. Runs `/setup`, receives Microsoft sign-in codes and outage alerts by DM.
GUILD_CHANNEL_ID=                   # Discord channel bridged to guild chat for account 1.

# ── Discord ───────────────────────────────────────────────────────────────
OFFICER_CHANNEL_ID=                 # Discord channel bridged to officer chat for account 1. Officer relay is off when unset.
STAFF_ROLE_ID=                      # Role allowed to run staff commands. When unset, staff commands are owner-only.
DISCORD_SERVER_ID=                  # Restrict the bot to one Discord server and publish slash commands there instantly. Interactions and messages from any other server are ignored.
LOG_CHANNEL_ID=                     # Channel for error and alert logs.

# ── Hypixel and Minecraft ─────────────────────────────────────────────────
HYPIXEL_API_KEY=                    # Hypixel API key, sent only as the `API-Key` header. Without it, live stat commands, join requirements, GEXP, verify/link and Apply reply with a one-line notice naming this variable.
MINECRAFT_HOST=                     # Server the Minecraft accounts connect to. Default: mc.hypixel.net.

# ── Multiple guilds (accounts and relay groups) ───────────────────────────
RELAY_GROUP=                        # Relay group of account 1. Accounts with the same group share guild and officer chat across guilds.
ACCOUNT_LABEL=                      # Short label for account 1 (max 16 characters), shown on lines relayed to other guilds. Default: G1.
# ACCOUNT_2_GUILD_CHANNEL_ID=       # Guild chat channel of account n (2 ≤ n ≤ 99). Setting it adds the account, and it is required for every extra account.
# ACCOUNT_2_OFFICER_CHANNEL_ID=     # Officer chat channel of account n.
# ACCOUNT_2_RELAY_GROUP=            # Relay group of account n.
# ACCOUNT_2_LABEL=                  # Label of account n (max 16 characters). Default: G<n>.

# ── Storage ───────────────────────────────────────────────────────────────
DATABASE_URL=                       # `mongodb://`, `mongodb+srv://`, `postgres://` or `postgresql://` URL. Unset: SQLite at `./data/bridge.db`, or on the Railway Volume. See docs/storage.md.

# ── REST API ──────────────────────────────────────────────────────────────
REST_API_TOKEN=                     # Enables the REST API. At least 16 characters; clients send `Authorization: Bearer <token>`. See [REST API](rest-api.md). Also used by the dashboard service as `BRIDGE_TOKEN`.
REST_API_PORT=                      # Port the REST API listens on. Default: 3000.
DASHBOARD_API=                      # Enables the dashboard endpoints on the REST API (settings, lists, audit, live events). Needs REST_API_TOKEN. Leave off unless you run the dashboard service; anyone with the token gets admin access to these endpoints. Default: false.

# ── GuildLB (optional) ────────────────────────────────────────────────────
GUILDLB_API_KEY=                    # GuildLB website-api key: stored networth for `!nw` when there is no Hypixel key.
GUILDLB_GUILD_KEY=                  # GuildLB guild-api key bound to your guild: alliance blacklist checks and `/alliance`. Must differ from `GUILDLB_API_KEY`.
GUILDLB_API_URL=                    # GuildLB base URL. https only, with no query string or credentials. Default: https://guildlb.com.

# ── Runtime ───────────────────────────────────────────────────────────────
LOG_LEVEL=                          # One of `debug`, `info`, `warn`, `error`. Default: info.
